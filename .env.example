# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
# Example for RDS/Postgres:
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@your-db-host.rds.amazonaws.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8085

# Storage
USE_S3=false
S3_BUCKET_NAME=your-upload-bucket
AWS_REGION=ap-south-1
CLOUDFRONT_DOMAIN=
S3_PRESIGN_URLS=false
S3_PRESIGN_EXPIRES_SECONDS=3600

# AWS credentials
# Preferred for local development: export AWS_PROFILE in your shell instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AI provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Vector store
VECTOR_STORE=chromadb
CHROMADB_PATH=./chroma_data
CHROMADB_COLLECTION_PREFIX=drip_directive

# Virtual try-on
# Use "legacy" for frontend/backend testing before Runpod is wired in.
VIRTUAL_TRYON_PROVIDER=legacy

# Runpod Serverless
RUNPOD_API_KEY=
RUNPOD_TRYON_ENDPOINT_ID=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
RUNPOD_TRYON_HTTP_TIMEOUT_SECONDS=30
RUNPOD_TRYON_POLL_INTERVAL_MS=2000
RUNPOD_TRYON_TIMEOUT_SECONDS=240

# Runpod Pod
RUNPOD_POD_API_URL=
RUNPOD_POD_API_TOKEN=
RUNPOD_POD_HTTP_TIMEOUT_SECONDS=300
RUNPOD_TRYON_MAX_IMAGE_DIMENSION=1024
RUNPOD_TRYON_GARMENT_PHOTO_TYPE=flat-lay
RUNPOD_TRYON_NUM_TIMESTEPS=30
RUNPOD_TRYON_GUIDANCE_SCALE=1.5
RUNPOD_TRYON_NUM_SAMPLES=1
RUNPOD_TRYON_SEGMENTATION_FREE=true
# RTX A4500 fallback if you hit OOM:
# RUNPOD_TRYON_MAX_IMAGE_DIMENSION=960
# RUNPOD_TRYON_NUM_TIMESTEPS=28
